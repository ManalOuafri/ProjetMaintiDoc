# Copier ce fichier en .env puis adapter si besoin.

# --- PostgreSQL / PGVector (voir docker-compose.yml) ---
PG_HOST=localhost
PG_PORT=5434
PG_USER=maintidoc
PG_PASSWORD=maintidoc
PG_DATABASE=maintidoc

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
VLM_MODEL=qwen2.5vl:3b

# --- Embeddings texte : BGE-M3 ---
# ollama      = BGE-M3 servi par Ollama (GPU, rapide)  -> ollama pull bge-m3
# huggingface = BGE-M3 via sentence-transformers (CPU, lent)
# Changer de backend impose de ré-indexer les documents.
EMBED_BACKEND=ollama
OLLAMA_EMBED_MODEL=bge-m3
TEXT_EMBED_MODEL=BAAI/bge-m3

# --- CLIP (HuggingFace, exécuté en local) ---
CLIP_MODEL=openai/clip-vit-base-patch32
# cpu ou cuda (cpu conseillé : la VRAM est laissée à Ollama)
EMBED_DEVICE=cpu
